@model BlogGeneratorApp.Models.Blog

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="card mb-4">
        <div class="card-body">
            <h1 class="card-title">@Model.Title</h1>
            <div class="d-flex justify-content-between mb-3">
                <div>
                    <span class="badge bg-primary">@Model.Category</span>
                    @if (Model.IsAutoGenerated)
                    {
                        <span class="badge bg-info ms-2">AI Generated</span>
                    }
                </div>
                <small class="text-muted">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
            </div>
            <h5 class="card-subtitle mb-3 text-muted">@Html.Raw(Model.Summary)</h5>
            <div class="author-info mb-4">
                <small class="text-muted">Written by @Model.Author | <i class="bi bi-eye"></i> @Model.ViewCount views</small>
            </div>
            <hr />
            <div class="blog-content">
                @Html.Raw(Model.Content)
            </div>
        </div>
        <div class="card-footer bg-white">
            <div class="d-flex justify-content-between">
                <div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Blogs
                    </a>
                </div>
                <div>
                    <button class="btn btn-outline-primary" onclick="shareBlog()">
                        <i class="bi bi-share"></i> Share
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function shareBlog() {
            if (navigator.share) {
                navigator.share({
                    title: '@Model.Title',
                    text: '@Model.Summary',
                    url: window.location.href,
                })
                    .then(() => console.log('Successful share'))
                    .catch((error) => console.log('Error sharing', error));
            } else {
                prompt('Share this blog:', window.location.href);
            }
        }
    </script>
}